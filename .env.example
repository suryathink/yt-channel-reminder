# Public URL of the app (used in email links and the Google OAuth redirect)
APP_URL=http://localhost:3000
PORT=3000

# Long random string used to sign links and cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# SQLite database file
DATABASE_PATH=./data/app.db

# Resend (https://resend.com). Without a key, emails are printed to the console instead.
RESEND_API_KEY=
# Must be on a domain you verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM=YT Reminder <onboarding@resend.dev>

# YouTube Data API v3 key (https://console.cloud.google.com). Strongly recommended:
# without it only the latest 15 videos of a channel can be fetched (via RSS).
YOUTUBE_API_KEY=

# Optional: Google OAuth client (Web application) to add watched videos to a private
# "Watched" playlist on the user's YouTube account. Redirect URI: <APP_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Defaults for new users (each user can change these in settings)
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_SEND_TIMES=10:00,20:00

# Videos shorter than this (seconds) are never picked, which skips Shorts. 0 = include everything.
MIN_VIDEO_SECONDS=180

# Optional: protects GET/POST /cron for external schedulers (serverless hosts).
CRON_SECRET=
# Set to 1 to disable the built-in once-a-minute scheduler (if you use /cron instead).
DISABLE_SCHEDULER=0
