# DOMAIN comes from the root .env (e.g. reminder.example.com).
# With a real domain Caddy gets and renews an HTTPS certificate automatically.
{$DOMAIN} {
	encode zstd gzip

	# API straight to Express; everything else to Next.js.
	handle /api/* {
		reverse_proxy server:4000
	}
	handle {
		reverse_proxy web:3000
	}
}
