PORT=4000

# Public URL of the Next.js frontend. Used in email links and redirects.
WEB_URL=http://localhost:3000

# Long random string used to sign links and sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=yt_reminder

# Resend (https://resend.com). Without a key, emails are printed to the console instead.
RESEND_API_KEY=
# Must be on a domain you verified in Resend. onboarding@resend.dev only delivers to your own Resend account email.
EMAIL_FROM=YT Reminder <onboarding@resend.dev>

# YouTube Data API v3 key. Without it only the latest 15 videos of a channel are available (RSS).
YOUTUBE_API_KEY=

# Optional: Google OAuth client for "Connect YouTube" (adds watched videos to a private playlist).
# Authorized redirect URI: <WEB_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Defaults for new users (each user can change these)
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_SEND_TIMES=10:00,20:00

# Videos shorter than this (seconds) are never picked, which skips Shorts. 0 = include everything.
MIN_VIDEO_SECONDS=180

# Optional: protects POST /api/cron for external schedulers.
CRON_SECRET=
# Set to 1 to disable the built-in once-a-minute scheduler (if you use /api/cron instead).
DISABLE_SCHEDULER=0
